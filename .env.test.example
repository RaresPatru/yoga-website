# Environment for the Playwright suite. Copy to .env.test and adjust.
#
# These values point at the LOCAL Supabase stack (`npx supabase start`), not the
# live project. tests/helpers.ts refuses to run against a non-local database,
# because the suite creates and deletes rows.
#
# `npx supabase start` prints the URL and keys for your machine — paste them in.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key printed by "supabase start">
SUPABASE_SECRET_KEY=<service_role key printed by "supabase start">

# The admin account the tests log in as. Created by supabase/seed.sql.
TEST_ADMIN_EMAIL=playwright-admin@test.local
TEST_ADMIN_PASSWORD=playwright-test-password

# Cloudflare's official Turnstile test keys.
#
# This pair ALWAYS passes verification, which is what finally makes the booking
# flow testable. Until now every registration test stopped at the CAPTCHA and
# asserted the error message, so a successful registration — the single most
# important path in the application — was never exercised at all.
#
# Other documented pairs, useful for testing the unhappy paths:
#   site 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AAA  -> always blocks
#   site 3x00000000000000000000FF                                                 -> forces an interactive challenge
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Stripe test-mode keys. Checkout is never actually completed in the suite; the
# webhook is driven directly with signed fixture events instead.
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend is not called in tests, but the app reads these at startup.
RESEND_API_KEY=re_test_placeholder
RESEND_FROM_EMAIL=test@example.com

# Test-only: scales the per-IP rate limits so a suite that shares 127.0.0.1
# across browser projects does not trip them. Never set in production.
RATE_LIMIT_MULTIPLIER=200
