# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones never get committed
.env*
# ...but the templates must be, otherwise nobody (including CI, and future you)
# knows which variables the app needs. These hold placeholders only.
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Playwright MCP artifacts
.playwright-mcp/

# Playwright
test-results/
playwright-report/
blob-report/

# local agent tooling (kept on disk, not in the repo)
.agents/
skills-lock.json

# Saved auth session for the Playwright admin project
.playwright/
.playwright-cli/

# Machine-specific Claude Code permissions
.claude/settings.local.json
